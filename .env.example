# Shared
ENVIRONMENT=development
LOG_LEVEL=info

# Gateway (Go)
GATEWAY_HTTP_PORT=8080
INFERENCE_GRPC_HOST=localhost
INFERENCE_GRPC_PORT=50051
INFERENCE_TIMEOUT_SECONDS=30
JWT_SECRET=

# AI inference service (Python)
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
