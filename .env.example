# Shared
ENVIRONMENT=development
LOG_LEVEL=info

# Gateway (Go)
GATEWAY_HTTP_PORT=8080
# GATEWAY_GRPC_PORT: reserved for future client-facing gRPC services
# (auth, session, medical logs) — not used by image diagnosis, which
# stays on HTTP because it needs multipart/form-data uploads.
GATEWAY_GRPC_PORT=9090
INFERENCE_GRPC_HOST=localhost
INFERENCE_GRPC_PORT=50051
INFERENCE_TIMEOUT_SECONDS=30
JWT_SECRET=

# Triage decision policy — tune as validation data accumulates.
# MALIGNANT_FLAG_THRESHOLD: malignant probability at/above this always
#   flags the result for clinician review, even if it isn't the top class.
# MIN_CONFIDENCE_FLOOR: below this, a low-risk result is reported as
#   inconclusive rather than a false-confident likely_benign.
MALIGNANT_FLAG_THRESHOLD=0.179
MIN_CONFIDENCE_FLOOR=0.4

# AI inference service (Python)
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
MODEL_PATH=./models/omnimed_breast_ultrasound.onnx
MODEL_VERSION=omnimed-breast-ultrasound-v1.0.0

# PostgreSQL (placeholder only — not wired to any repository yet)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=omnimed
POSTGRES_PASSWORD=omnimed
POSTGRES_DB=omnimed
POSTGRES_SSLMODE=disable
